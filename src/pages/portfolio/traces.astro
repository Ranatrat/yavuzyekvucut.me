---
import BaseLayout from '../../layouts/BaseLayout.astro';

const PB_URL = 'https://api.yavuzyekvucut.me';
let photos = [];

try {
  // "=" yerine "~" (contains/benzer) kullandık ve URL encoding ekledik
  const filterQuery = encodeURIComponent("category~'traces'");
  const response = await fetch(`${PB_URL}/api/collections/portfolio/records?perPage=100&sort=-created&filter=${filterQuery}`);
  if (response.ok) {
    const data = await response.json();
    photos = data.items;
  }
} catch (error) {
  console.error("PocketBase error:", error);
}

const getImageUrl = (photo) => {
  if (!photo.image) return '';
  const fileName = Array.isArray(photo.image) ? photo.image[0] : photo.image;
  return `${PB_URL}/api/files/${photo.collectionId}/${photo.id}/${fileName}`;
};

const leftColumn = photos.filter((_, index) => index % 2 === 0);
const rightColumn = photos.filter((_, index) => index % 2 !== 0);
---

<BaseLayout title="Traces">
  <div class="text-center mb-16 md:mb-24">
    <h1 class="font-normal text-sm md:text-base tracking-[5px] uppercase">Traces</h1>
  </div>

  {photos.length === 0 ? (
    <p class="text-center opacity-50 uppercase tracking-widest text-xs">Henüz fotoğraf eklenmedi.</p>
  ) : (
    <div class="flex flex-col md:flex-row gap-x-16 md:gap-x-32 max-w-6xl mx-auto px-4 pb-32">
      
      {/* Sol Sütun */}
      <div class="flex-1 flex flex-col gap-y-16 md:gap-y-32 w-full">
        {leftColumn.map((photo) => (
          <img 
            src={getImageUrl(photo)} 
            alt={photo.title || 'Traces Photography'} 
            onclick="openLightbox(this.src)"
            class="w-full h-auto cursor-pointer hover:opacity-90 transition-opacity duration-500" 
          />
        ))}
      </div>

      {/* Sağ Sütun */}
      <div class="flex-1 flex flex-col gap-y-16 md:gap-y-32 w-full mt-16 md:mt-48">
        {rightColumn.map((photo) => (
          <img 
            src={getImageUrl(photo)} 
            alt={photo.title || 'Traces Photography'} 
            onclick="openLightbox(this.src)"
            class="w-full h-auto cursor-pointer hover:opacity-90 transition-opacity duration-500" 
          />
        ))}
      </div>

    </div>
  )}
</BaseLayout>
