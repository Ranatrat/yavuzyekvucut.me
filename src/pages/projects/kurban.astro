---
import BaseLayout from '../../layouts/BaseLayout.astro';

const PB_URL = 'https://api.yavuzyekvucut.me';
let photos = [];

try {
  const filterQuery = encodeURIComponent("category~'kurban'");
  const response = await fetch(`${PB_URL}/api/collections/photos/records?perPage=100&sort=-created&filter=${filterQuery}`);
  if (response.ok) {
    const data = await response.json();
    photos = data.items;
  }
} catch (error) {
  console.error("PocketBase error:", error);
}

const getImageUrl = (photo) => {
  if (!photo.image) return '';
  const fileName = Array.isArray(photo.image) ? photo.image[0] : photo.image;
  return `${PB_URL}/api/files/${photo.collectionId}/${photo.id}/${fileName}`;
};
---

<BaseLayout title="Kurban">
  <!-- İçerik Kapsayıcısı -->
  <div class="flex flex-col md:flex-row gap-16 md:gap-24 max-w-7xl mx-auto px-5 pb-32 pt-10">
    
    <!-- SOL SÜTUN: Sabit Yazı (Sticky Sidebar) -->
    <div class="w-full md:w-1/3 lg:w-1/4">
      <div class="md:sticky md:top-32">
        <h1 class="font-normal text-xl md:text-2xl tracking-[5px] uppercase mb-8">Kurban</h1>
        
        <!-- Proje Metni -->
        <div class="text-sm leading-relaxed tracking-wide opacity-80 space-y-6">
          <p>
Kurban Bayramı, dayanışma, paylaşma ve inanç üzerinden anlatılan bir ritüel olarak hatırlanır. Ancak bu ritüelin merkezindeki ölüm, çoğu zaman görünmezleştirilir. Kan temizlenir, bedenler parçalanır, geriye yalnızca geleneğin kabul edilmiş anlatısı kalır.
          </p>
          <p>
Bu seri, bayramın görünmez bırakılan yüzüne bakıyor. Kesim alanlarında, insanların gündelik bir iş yaparcasına sürdürdüğü hareketler; bekleyen bedenler, akan kan ve parçalanan yaşamlar aynı kadrajda buluşuyor. Fotoğraflar vahşeti büyütmeye çalışmıyor; aksine onun ne kadar sıradanlaştığını gösteriyor.
          </p>
          <p>
On üç fotoğraf boyunca izleyici, yalnızca hayvanların ölümüyle değil, ölüm karşısındaki kolektif kayıtsızlıkla da yüzleşmeye davet ediliyor. Seri, vegan etik perspektifinden şu soruyu ortaya koyuyor: Bir yaşamın sona erişi, gelenek tarafından meşrulaştırıldığında neden artık şiddet olarak görülmez?
          </p>
  	  <p>
Bu çalışma, kurbanı değil, normalleşmiş şiddeti belgeliyor.
          </p>
	 </p>
Kocaeli, Türkiye, 2026
	 </p>
        </div>
      </div>
    </div>

    <!-- SAĞ SÜTUN: Akışkan Galeri -->
    <div class="w-full md:w-2/3 lg:w-3/4 flex flex-col gap-y-16 md:gap-y-32">
      {photos.length === 0 ? (
        <p class="opacity-50 uppercase tracking-widest text-xs">Henüz fotoğraf eklenmedi.</p>
      ) : (
        photos.map((photo) => (
          <img 
            src={getImageUrl(photo)} 
            alt={photo.title || 'Kurban Project'} 
            onclick="openLightbox(this.src)"
            class="w-full h-auto cursor-pointer hover:opacity-90 transition-opacity duration-500" 
          />
        ))
      )}
    </div>

  </div>
</BaseLayout>
