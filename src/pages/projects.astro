---
import BaseLayout from '../layouts/BaseLayout.astro';

const PB_URL = 'https://api.yavuzyekvucut.me';

let settings = {};
try {
  const response = await fetch(`${PB_URL}/api/collections/site_settings/records`);
  const data = await response.json();
  settings = data.items[0] || {};
} catch (e) {
  console.error("PocketBase bağlantı hatası:", e);
}

function getImg(filename) {
  // Görsel yoksa Unsplash'ten geçici bir şablon gösterir
  if (!filename) return 'https://images.unsplash.com/photo-1493397212122-2b85edf8106b?auto=format&fit=crop&w=800';
  return `${PB_URL}/api/files/${settings.collectionId}/${settings.id}/${filename}`;
}
---

<BaseLayout title="Projects">
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24 max-w-5xl mx-auto pb-32 pt-10 px-4">

    <!-- 1. Kurban Projesi -->
    <a href="/projects/kurban" class="group relative block overflow-hidden aspect-[2/3] cursor-pointer">
      <img src={getImg(settings.cover_kurban)} alt="Kurban Project" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
      <div class="absolute inset-0 bg-black/20 dark:bg-black/40 light:bg-white/10 group-hover:bg-black/60 transition-colors duration-500 flex items-center justify-center">
        <span class="text-white font-normal tracking-[5px] uppercase text-xl">Kurban</span>
      </div>
    </a>

    <!-- İleride eklenecek yeni projeler buraya (2., 3. olarak) gelecek -->

  </div>
</BaseLayout>
