---
import BaseLayout from '../layouts/BaseLayout.astro';

const PB_URL = 'https://api.yavuzyekvucut.me'; 
let items = [];

try {
  const response = await fetch(`${PB_URL}/api/collections/portfolio/records?perPage=100&sort=-created&filter=(category='Traces')`, {
    signal: AbortSignal.timeout(5000)
  });
  
  if (response.ok) {
    const data = await response.json();
    items = data.items;
  }
} catch (error) {
  console.error("PocketBase'den veriler çekilemedi:", error);
}

function getImg(item) {
  const file = Array.isArray(item.image) ? item.image[0] : item.image;
  return `${PB_URL}/api/files/${item.collectionId}/${item.id}/${file}`;
}
---

<BaseLayout title="Traces">
  
  <div class="text-center mb-16">
    <h1 class="font-normal text-sm md:text-base tracking-[5px] uppercase">Traces</h1>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-32">
    {items.map((item) => (
      <div class="group relative overflow-hidden aspect-[4/5] cursor-pointer" onclick={`openLightbox('${getImg(item)}')`}>
        <img src={getImg(item)} alt={item.title || 'Traces Photo'} class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
      </div>
    ))}
  </div>

</BaseLayout>
