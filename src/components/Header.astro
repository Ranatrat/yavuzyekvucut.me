<header class="text-center pt-24 pb-10 px-5 relative">
  <h1 class="font-normal text-3xl md:text-4xl tracking-[7px] uppercase mb-10">Yavuz Yekvücut</h1>
  
  <nav class="flex justify-center gap-8 md:gap-16 pb-10 flex-wrap">
    <a href="/" class="text-portfolio-vintage-nav light:text-portfolio-white-nav hover:text-portfolio-vintage-navHover light:hover:text-portfolio-white-navHover text-sm tracking-[3.5px] uppercase transition-colors">Home</a>
    <a href="/portfolio" class="text-portfolio-vintage-nav light:text-portfolio-white-nav hover:text-portfolio-vintage-navHover light:hover:text-portfolio-white-navHover text-sm tracking-[3.5px] uppercase transition-colors">Portfolio</a>
    <a href="/portfolio/traces" class="text-portfolio-vintage-nav light:text-portfolio-white-nav hover:text-portfolio-vintage-navHover light:hover:text-portfolio-white-navHover text-sm tracking-[3.5px] uppercase transition-colors">Traces</a>
    <a href="/portfolio/encounters" class="text-portfolio-vintage-nav light:text-portfolio-white-nav hover:text-portfolio-vintage-navHover light:hover:text-portfolio-white-navHover text-sm tracking-[3.5px] uppercase transition-colors">Encounters</a>
    <a href="/about" class="text-portfolio-vintage-nav light:text-portfolio-white-nav hover:text-portfolio-vintage-navHover light:hover:text-portfolio-white-navHover text-sm tracking-[3.5px] uppercase transition-colors">About</a>
    <a href="/contact" class="text-portfolio-vintage-nav light:text-portfolio-white-nav hover:text-portfolio-vintage-navHover light:hover:text-portfolio-white-navHover text-sm tracking-[3.5px] uppercase transition-colors">Contact</a>
  </nav>

  <div class="absolute top-8 right-8 md:top-12 md:right-20 flex items-center gap-4 text-xs tracking-[2.5px] uppercase z-50">
    <span>Dark</span>
    <label class="relative inline-block w-12 h-6 cursor-pointer">
      <input type="checkbox" id="theme-toggle" class="sr-only peer">
      <div class="w-full h-full bg-transparent border border-portfolio-vintage-text light:border-portfolio-white-text rounded-full peer-checked:after:translate-x-6 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-portfolio-vintage-text light:after:bg-portfolio-white-text after:rounded-full after:h-5 after:w-5 after:transition-all"></div>
    </label>
    <span>Light</span>
  </div>
</header>

<script is:inline>
  const themeToggle = document.getElementById('theme-toggle');
  const htmlElement = document.documentElement;

  // Temayı uygulama fonksiyonu
  const applyTheme = (theme) => {
    if (theme === 'light') {
      htmlElement.classList.add('light');
      if (themeToggle) themeToggle.checked = true;
    } else {
      htmlElement.classList.remove('light');
      if (themeToggle) themeToggle.checked = false;
    }
  };

  // 1. Sayfa yüklendiğinde hafızadaki temayı kontrol et
  const savedTheme = localStorage.getItem('theme') || 'dark';
  applyTheme(savedTheme);

  // 2. Buton değiştiğinde temayı güncelle ve kaydet
  if (themeToggle) {
    themeToggle.addEventListener('change', function() {
      const newTheme = this.checked ? 'light' : 'dark';
      applyTheme(newTheme);
      localStorage.setItem('theme', newTheme);
    });
  }
</script>
